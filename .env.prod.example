# Copy to .env.prod and fill in before running docker-compose.prod.yml.
# Never commit the filled-in file.

APP_KEY=
APP_URL=https://www.scholarzim.co.zw

DB_DATABASE=scholarzim
DB_USERNAME=scholarzim
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Mail leaves the request that triggered it. The image supervises a worker that
# drains the jobs table; nothing is sent without one.
QUEUE_CONNECTION=database


MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=noreply@scholarzim.co.zw
MAIL_FROM_NAME=ScholarZim
MAILGUN_DOMAIN=scholarzim.co.zw
MAILGUN_SECRET=your-mailgun-api-key
MAILGUN_ENDPOINT=api.mailgun.net

# Cloudflare R2 for uploaded documents (S3-compatible API).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=scholarzim-uploads
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true