# Copy to .env.prod and fill in real values. Never commit .env.prod.

SCHOLARZIM_DB_USER=scholarzim
SCHOLARZIM_DB_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

SCHOLARZIM_APP_BASE_URL=https://www.scholarzim.com
SCHOLARZIM_MAIL_FROM=noreply@scholarzim.com

# SMTP — unused when deploying behind a host that blocks outbound SMTP (e.g. Render free
# tier); kept for VPS deploys where SMTP isn't blocked. Ignored entirely if you're on the
# Mailgun path below (MailgunEmailServiceImpl only activates in the prod profile).
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Mailgun transactional email (recommended for hosts that block outbound SMTP)
MAILGUN_API_KEY=your_mailgun_api_key_here
# Sandbox domain for now — only recipients authorized in the Mailgun dashboard receive
# mail. Swap both of these once a real sending domain is verified in Mailgun.
MAILGUN_DOMAIN=sandboxdaeabb4168e44044b93cb139993aecb3.mailgun.org
MAILGUN_FROM_EMAIL=postmaster@sandboxdaeabb4168e44044b93cb139993aecb3.mailgun.org
MAILGUN_FROM_NAME=ScholarZim

JAVA_OPTS=-Xms256m -Xmx768m
