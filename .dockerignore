# Keep the build context small — everything here is either rebuilt inside the
# image or has no business in it.

.git/
.github/
.idea/
.vscode/

# Installed inside the image by composer
/vendor/

# Node
/node_modules/
/public/build/
/public/hot

# Runtime state and secrets
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
.env
.env.*
!.env.example
.phpunit.result.cache

# Docs and local artifacts
*.md
docs/
docker-compose*.yml
cookies.txt
debug-*.log

# Local CA certificates for managed MySQL. Never baked into an image - on
# Render the certificate arrives as a mounted secret file instead.
/storage/certs/*
!/storage/certs/.gitignore
!/storage/certs/README.md

# Local-only credentials and tooling. `.env.*` above does not match a file such
# as qa-credentials.env, and this build copies the whole context (`COPY . .`),
# so any such file present on a developer machine would be baked into the image.
*.env
.claude/
.kilo/
.phpunit.cache/
/database/*.sqlite
/tests/Browser/screenshots/
/tests/Browser/console/
