# Keep the build context small — everything here is either rebuilt inside the
# image or has no business in it.

.git/
.github/
.idea/
.vscode/

# Installed inside the image by composer
/vendor/

# Node
/node_modules/
/public/build/
/public/hot

# Runtime state and secrets
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
.env
.env.*
!.env.example
.phpunit.result.cache

# Docs and local artifacts
*.md
docs/
docker-compose*.yml
cookies.txt
debug-*.log
