# Keep the build context small — everything here is either rebuilt inside the
# image or has no business in it.

.git/
.github/
.idea/
.vscode/

# Java build output
backend/target/

# Node
frontend/node_modules/
frontend/dist/
**/*.tsbuildinfo

# Generated by the frontend build stage inside the image; a stale local copy
# must never shadow it.
backend/src/main/resources/static/app/

# Runtime data and secrets
backend/uploads/
backend/database/backups/
**/.env
**/.env.local
**/.env.prod

# Docs and local artifacts
*.md
!backend/README.md
docker-compose*.yml
cookies.txt
debug-*.log
