APP_NAME=ScholarZim
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Harare
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Only when something else terminates TLS in front of the app (nginx, Caddy, a
# load balancer). Left unset the app trusts no proxy, ignores X-Forwarded-Proto,
# and so treats HTTPS traffic as plain HTTP - which silently drops the HSTS
# header. Use "*" only where the app is reachable through the proxy alone;
# otherwise list the proxy's address.
# TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scholarzim
DB_USERNAME=root
DB_PASSWORD=

# TLS to a managed MySQL (Aiven, PlanetScale, ...). Leave this unset for a local
# MySQL: with no value the SSL attribute is never passed to the driver and the
# connection behaves exactly as it did before.
#
# Set it and the driver verifies the server against this CA - a missing or wrong
# file is refused, not quietly downgraded to plaintext. A relative path is
# resolved against the project root, so it works under both artisan and php-fpm.
#
# Local:  download the CA from the Aiven console into storage/certs/ (gitignored)
# Render: upload it as a Secret File; the runtime mounts it under /etc/secrets/
#         and this becomes MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
# MYSQL_ATTR_SSL_CA=storage/certs/aiven-ca.pem

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Notifications and mail are queued so a request never waits on SMTP. Run a
# worker alongside the app: php artisan queue:work
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120


# Mail transport. ScholarZim sends every message through EmailService ->
# ScholarZimMail -> the mailer named here. Three supported setups:
#
#   mailgun  Production. The Mailgun HTTP API; needs the three MAILGUN_* values
#            below, read from the environment via config/services.php.
#   smtp     Local Docker. `docker compose up` overrides MAIL_MAILER to smtp and
#            points it at the bundled MailHog (UI on http://localhost:8025), so
#            nothing leaves the machine and no Mailgun key is needed.
#   log      Local without Docker. Writes each message to storage/logs -
#            the quickest way to read a verification link on a fresh clone.
#
# The default below is the production transport. Switch it to `log` for local
# work unless you have a real Mailgun key.
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=no-reply@scholarzim.co.zw
MAIL_FROM_NAME=ScholarZim
MAILGUN_DOMAIN=scholarzim.co.zw
MAILGUN_SECRET=your-mailgun-api-key
MAILGUN_ENDPOINT=api.mailgun.net



SCHOLARZIM_ADMIN_EMAIL=admin@scholarzim.co.zw
SCHOLARZIM_ADMIN_PASSWORD=ChangeMe123

# Container-only knobs, read by docker/entrypoint.sh. Ignored by `artisan serve`.
SCHOLARZIM_RUN_MIGRATIONS=true
SCHOLARZIM_DEMO_SEED=false
