# Local Docker dev environment for ScholarZim.
# Copy to .env (same folder as docker-compose.yml) and adjust as needed:
#   cp .env.example .env
# .env is gitignored — never commit it. Defaults below are fine for local dev.

# --- MySQL ---
MYSQL_DATABASE=scholarzim
MYSQL_USER=scholarzim
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Host port for connecting a DB client (Workbench/IntelliJ) to the
# containerized MySQL. The app itself always uses mysql:3306 internally.
# Defaults to 3307 since a native/local MySQL install usually already owns 3306.
MYSQL_HOST_PORT=3307

# --- App ---
SPRING_PROFILES_ACTIVE=demo
SCHOLARZIM_DEMO_SEED=true
SCHOLARZIM_APP_BASE_URL=http://localhost:8080
APP_HOST_PORT=8080
