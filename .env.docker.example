# Copy to .env.docker and run `docker compose --env-file .env.docker up`.
# Kept separate from .env so the native (artisan serve) setup can keep using
# the host MySQL as root, while the container stack uses its own credentials —
# the mysql:8.0 image rejects MYSQL_USER=root.

APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_HOST_PORT=8000

DB_DATABASE=scholarzim
DB_USERNAME=scholarzim
DB_PASSWORD=scholarzim_dev_password
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3307

# Leave these unset to trap all mail in MailHog at http://localhost:8025 —
# nothing reaches a real inbox, which is what you want for local testing.
# Verification and password-reset mail will appear there, not in your email.
#
# To test real delivery instead, uncomment the block below and fill in the
# Mailgun key. Do not commit the filled-in .env.docker.
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=scholarzim.co.zw
# MAILGUN_SECRET=your-mailgun-api-key
# MAILGUN_ENDPOINT=api.mailgun.net
# MAIL_FROM_ADDRESS=no-reply@scholarzim.co.zw
# MAIL_FROM_NAME=ScholarZim

SCHOLARZIM_DEMO_SEED=true
